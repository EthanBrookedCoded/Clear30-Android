<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Allow cleartext HTTP ONLY to the local Supabase dev host. Production
      (quluipmdicjsolnsopkg.supabase.co) uses HTTPS and is unaffected. 10.0.2.2
      is the host loopback from the Android emulator; 127.0.0.1/localhost cover
      device-loopback / adb reverse setups. Add your machine's LAN IP here too if
      you run on a physical device against local Supabase.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
