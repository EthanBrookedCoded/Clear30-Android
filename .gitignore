# Clear30 Android — ignores

# macOS / IDE
.DS_Store
.idea/
*.iml
.vscode/
.cursor/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.kotlin/
android/app/release/
android/app/google-services.json

# Gradle wrapper jar — regenerated by Studio / `gradle wrapper`
android/gradle/wrapper/gradle-wrapper.jar
android/gradlew
android/gradlew.bat

# Generated by KSP / Compose compiler
**/kotlin/**/*.kotlin_module
**/generated/

# Secrets / keys (also covered by local.properties above)
**/*.keystore
**/keystore.properties

# Web / Backend node modules (in case lockfile-less)
**/node_modules/

# OS / editor cruft
*.swp
*~
