{
  "name": "clear30-webapps",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @clear30/shared dev\" \"pnpm --filter @clear30/supplements dev\" \"pnpm --filter @clear30/test-app dev\"",
    "build": "pnpm --filter @clear30/shared build && pnpm --filter \"./packages/apps/*\" build",
    "build:shared": "pnpm --filter @clear30/shared build",
    "build:supabase-test": "pnpm --filter supabase-test build",
    "deploy": "pnpm build && node scripts/deploy.js",
    "create-app": "node scripts/create-app.js",
    "update-favicons": "node scripts/update-favicons.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "react-feather": "^2.0.10"
  }
}
